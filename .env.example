# Groq API key — required. Powers the planner, researchers, and synthesizer.
# https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Tavily search API key — for real web search. https://app.tavily.com
TAVILY_API_KEY=your_key_here

# Exa search API key — optional, for the alternative search provider. https://exa.ai
EXA_API_KEY=your_key_here
